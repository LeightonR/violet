{
  "manifest_version": 3,
  "name": "Violet Docs Caret",
  "version": "1.0.0",
  "description": "Sends only the local Google Docs caret geometry to Violet.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://docs.google.com/document/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
